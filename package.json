		"@types/three": "^0.187.0",
		"@vitest/browser": "^5.1.1",
		"@vitest/browser-playwright": "^5.1.1",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
