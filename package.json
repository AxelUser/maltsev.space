{
	"name": "maltsev.space",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run generate-og && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"generate-og": "node scripts/generate-og-images.js",
		"generate-og:force": "node scripts/generate-og-images.js --force",
		"perf": "playwright test -c perf/playwright.config.ts"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
