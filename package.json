		"@vitest/browser": "^3.2.3",
		"@vitest/coverage-v8": "^3.2.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-storybook": "^9.0.10",
		"eslint-plugin-svelte": "^3.0.0",
		"glob": "^11.0.0",
